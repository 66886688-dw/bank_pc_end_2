<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.dao.BankTransactionMapper">

    <resultMap id="BaseResultMap" type="com.bank.entity.BankTransaction">
        <id column="id" property="id"/>
        <result column="account_id" property="accountId"/>
        <result column="user_id" property="userId"/>
        <result column="trans_type" property="transType"/>
        <result column="amount" property="amount"/>
        <result column="balance_after" property="balanceAfter"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, account_id, user_id, trans_type, amount, balance_after, remark, create_time
    </sql>

    <insert id="insert" parameterType="com.bank.entity.BankTransaction" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bank_transaction (account_id, user_id, trans_type, amount, balance_after, remark)
        VALUES (#{accountId}, #{userId}, #{transType}, #{amount}, #{balanceAfter}, #{remark})
    </insert>

</mapper>
